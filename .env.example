# TerraGuard AI Environment Configuration
PROJECT_NAME="TerraGuard AI"
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite with spatial helper, or PostgreSQL with PostGIS)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terraguard_db
DATABASE_URL=sqlite:///./terraguard.db

# Storage Directories
STORAGE_DIR=./storage
DEMO_DATA_DIR=./demo_data

# Satellite API Integration (Optional Copernicus Data Space Ecosystem)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_ENABLED=false

# Demo Mode
DEMO_MODE=true
